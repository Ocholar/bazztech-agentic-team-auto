                "text": "={{ [{\"role\": \"system\", \"content\": \"You are a manufacturing intelligence assistant for tenant \" + ($('Webhook').item.json.body.tenantId || 'General') + \". Answer based on the provided context.\"}, {\"role\": \"user\", \"content\": $('Prepare Context').item.json.context + '\\n\\nQuery: ' + $('Prepare Context').item.json.query}] }}",
                "options": {}
