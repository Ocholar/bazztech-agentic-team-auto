                "jsCode": "// Holt-Winters with multi-tenant data fetching simulation\nconst params = $('Extract Forecast Params').item.json;\nconst tenantId = $('Webhook').item.json.body.tenantId || 'default';\n// In a real system, we'd fetch from a DB using tenantId\n// For now, we simulate with a safety factor adjustment per tenant\n\nreturn [{ json: { ...params, tenantId } }];"
